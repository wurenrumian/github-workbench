{
  "manifest_version": 3,
  "name": "GitHub Workbench",
  "short_name": "GH Workbench",
  "version": "0.2.0",
  "description": "把 github.com 首页换成个人工作台：贡献日历、通知收件箱、指派给我的 issue、待评审 PR、关注的项目、最近仓库。零配置、不用 token。",
  "minimum_chrome_version": "110",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "action": {
    "default_title": "GitHub Workbench",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/content/boot.js"],
      "css": ["src/content/boot.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://github.com/*"],
      "js": [
        "src/core/util.js",
        "src/core/store.js",
        "src/core/parse.js",
        "src/core/api.js",
        "src/content/icons.js",
        "src/content/ui.js",
        "src/content/index.js"
      ],
      "css": ["src/content/styles.css"],
      "run_at": "document_end"
    }
  ]
}

